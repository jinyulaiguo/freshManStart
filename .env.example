# ============================================================================
# freshManStart 基础设施与环境变量配置模版 (.env.example)
# 说明：仅定义配置变量 Key 契约，真实敏感信息请在本地 .env 中配置
#
# 【你需要自行提供的值】标注为 [必填] / [可选]
# 【本机默认即可】标注为 [本地默认] —— 配合 w16 docker-compose 可直接用
# ============================================================================

PYTHONPATH=.

# ----------------------------------------------------------------------------
# 大模型 API（MiniMax / OpenAI Compatible）
# ----------------------------------------------------------------------------
# [必填] 从 MiniMax 控制台复制 API Key
MINIMAX_API_KEY="your_minimax_api_key_here"
# [本地默认] OpenAI 兼容网关地址与模型名
MINIMAX_BASE_URL="https://api.minimax.chat/v1"
MINIMAX_MODEL="MiniMax-M3"

# ----------------------------------------------------------------------------
# Redis 分布式 Checkpointer
# ----------------------------------------------------------------------------
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# [可选] 本地无密码可留空或占位
REDIS_PASSWORD="your_redis_password_here"
REDIS_DB=0

# ----------------------------------------------------------------------------
# PostgreSQL 分布式 Checkpointer
# ----------------------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
# [必填-若启用 PG Checkpointer] 与本地/容器 Postgres 账号一致
POSTGRES_USER="your_postgres_user_here"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="langgraph_checkpoints"

# ============================================================================
# Week 16 · 可观测性（Observability）
# 配套脚本：weekly/w16_observability/infra/docker-compose.yml
# ============================================================================

# ----------------------------------------------------------------------------
# LangSmith（Day 106：托管追踪，不改业务代码即可开 Trace）
# 申请：https://smith.langchain.com/ → Settings → API Keys
# ----------------------------------------------------------------------------
# [必填-若使用 LangSmith] 平台 API Key
LANGSMITH_API_KEY="your_langsmith_api_key_here"
# [本地默认] true=开启追踪；false=关闭（不影响业务）
LANGSMITH_TRACING="true"
# [可选] 项目名，便于在后台筛选；不填则用默认
LANGSMITH_PROJECT="freshman-w16-observability"
# [可选] 兼容旧环境变量名（部分 LangChain 文档仍使用）
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="your_langsmith_api_key_here"
# LANGCHAIN_PROJECT="freshman-w16-observability"

# ----------------------------------------------------------------------------
# Phoenix + OpenTelemetry（Day 107+：本地私有化追踪）
# UI / OTLP HTTP：http://localhost:6006
# OTLP gRPC：localhost:4317
# ----------------------------------------------------------------------------
# [本地默认] Phoenix UI + HTTP collector 根地址（勿带 /v1/traces）
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006"
# [本地默认] OTLP HTTP 完整 traces 端点（Exporter 常用）
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:6006/v1/traces"
# [本地默认] 协议：http/protobuf（对接 Phoenix :6006）；若走 gRPC 则改为 grpc 且端点用 :4317
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
# [本地默认] 资源属性：服务名，会显示在 Trace Resource 上
OTEL_SERVICE_NAME="ai-research-assistant"
# [本地默认] Phoenix 项目名（phoenix.otel.register 的 project_name）
PHOENIX_PROJECT_NAME="freshman-w16-observability"
# [本地默认] false=本地学习免登录；true=需同时配置 PHOENIX_SECRET
PHOENIX_ENABLE_AUTH="false"
# [可选] 仅当 PHOENIX_ENABLE_AUTH=true 时需要；本地学习可留空
PHOENIX_API_KEY=""
# [可选] 开启鉴权时的 JWT 密钥（≥32 字符）；默认提供本地学习安全占位
PHOENIX_SECRET="default_phoenix_secret_key_32_chars_long_local_dev"

# ----------------------------------------------------------------------------
# Prometheus / Grafana / Agent Metrics（Day 111–112）
# Prometheus UI：http://localhost:9090
# Grafana UI：http://localhost:3000  （默认账号见下方）
# Agent /metrics：由练习脚本暴露，默认 http://host.docker.internal:9108/metrics
# ----------------------------------------------------------------------------
# [本地默认] 本机 Agent 暴露 Prometheus 指标的端口（compose 内 Prometheus 会抓取）
AGENT_METRICS_HOST="host.docker.internal"
AGENT_METRICS_PORT="9108"
# [本地默认] Grafana 初始登录（首次进入后请自行修改）
GF_SECURITY_ADMIN_USER="admin"
# [必填-若对外暴露 Grafana] 请改成你自己的强密码；仅本机学习可保持占位
GF_SECURITY_ADMIN_PASSWORD="change_me_grafana_admin"

# ----------------------------------------------------------------------------
# Token 计费价目（Day 109 / 112：美分成本估算，可按实际模型改）
# 单位：USD / 1M tokens
# ----------------------------------------------------------------------------
# [可选] 不填则代码内可使用下方默认价目
LLM_PRICE_INPUT_USD_PER_1M="0.15"
LLM_PRICE_OUTPUT_USD_PER_1M="0.60"
